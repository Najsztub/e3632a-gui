/* Agilent E3632A Professional GUI - Light Theme */

QMainWindow {
    background-color: #ffffff;
}

QWidget {
    font-family: "Consolas", "Courier New", monospace;
    color: #24292f;
}

QLabel {
    color: #24292f;
    background: transparent;
}

QGroupBox {
    border: 1px solid #d0d7de;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 8px;
    font-size: 10px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #0969da;
    font-weight: bold;
    font-size: 10px;
}
QGroupBox::indicator {
    width: 13px;
    height: 13px;
}

QPushButton {
    background-color: #f6f8fa;
    color: #0969da;
    border: 1px solid #d0d7de;
    padding: 5px 10px;
    border-radius: 3px;
    font-size: 10px;
}
QPushButton:hover {
    background-color: #eaeef2;
    border-color: #0969da;
}
QPushButton:pressed {
    background-color: #ddf4ff;
}
QPushButton:disabled {
    color: #8c959f;
    border-color: #d0d7de;
}

QComboBox {
    background-color: #f6f8fa;
    color: #24292f;
    border: 1px solid #d0d7de;
    padding: 3px 6px;
    border-radius: 3px;
    font-size: 10px;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 5px solid #0969da;
    margin-right: 4px;
}
QComboBox:hover {
    border-color: #0969da;
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #f6f8fa;
    color: #0969da;
    border: 1px solid #d0d7de;
    padding: 3px 5px;
    border-radius: 2px;
    font-size: 10px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0969da;
}

QCheckBox {
    color: #656d76;
    font-size: 9px;
    spacing: 4px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #d0d7de;
    border-radius: 3px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #0969da;
    border-color: #0969da;
}
QCheckBox:hover {
    color: #24292f;
}

QTabWidget::pane {
    border: 1px solid #d0d7de;
    background-color: #ffffff;
}
QTabBar::tab {
    background-color: #f6f8fa;
    color: #656d76;
    padding: 7px 14px;
    border: 1px solid #d0d7de;
    border-bottom: none;
    font-size: 10px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0969da;
    border-bottom: 2px solid #0969da;
}
QTabBar::tab:hover {
    color: #24292f;
}

QTextEdit {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
    font-family: "Consolas", monospace;
    font-size: 10px;
}
QTextEdit:focus {
    border-color: #0969da;
}

QScrollBar:vertical {
    background: #f6f8fa;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #d0d7de;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #8c959f;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #f6f8fa;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #d0d7de;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #8c959f;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QSplitter::handle {
    background: #d0d7de;
    width: 1px;
    height: 1px;
}

QScrollArea {
    border: none;
    background-color: #f6f8fa;
}

QFrame[frameShape="4"] {
    color: #d0d7de;
}

QTableWidget {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
    gridline-color: #eaeef2;
    font-size: 10px;
}
QHeaderView::section {
    background-color: #f6f8fa;
    color: #656d76;
    border: 1px solid #d0d7de;
    padding: 4px;
    font-size: 9px;
    font-weight: bold;
}
QTableWidget::item {
    padding: 2px 4px;
}
QTableWidget::item:selected {
    background-color: #ddf4ff;
    color: #0969da;
}

QMenuBar {
    background-color: #f6f8fa;
    color: #656d76;
    border-bottom: 1px solid #d0d7de;
}
QMenuBar::item:selected {
    background-color: #eaeef2;
    color: #0969da;
}
QMenu {
    background-color: #ffffff;
    color: #24292f;
    border: 1px solid #d0d7de;
}
QMenu::item:selected {
    background-color: #eaeef2;
    color: #0969da;
}

QStatusBar {
    background-color: #f6f8fa;
    color: #656d76;
    border-top: 1px solid #d0d7de;
    font-size: 9px;
}

/* --- Object-Name Widget Styles --- */

#leftPanel {
    background-color: #f6f8fa;
}
#titleLabel {
    font-size: 16px; font-weight: bold; color: #24292f; padding: 2px 0;
}
#subtitleLabel {
    color: #656d76; font-size: 10px;
}
#idnLabel {
    color: #656d76; font-size: 8px;
}
#liveBar {
    background-color: #ffffff; border: 1px solid #d0d7de; border-radius: 4px; padding: 4px;
}
#liveSep {
    color: #d0d7de; font-size: 16px;
}
#liveSubheader {
    font-size: 10px; font-weight: bold; color: #656d76;
}
#chTabs QTabWidget::pane {
    border: none; background: transparent;
}
#chTabs QTabBar::tab {
    background: #f6f8fa; color: #656d76; padding: 3px 10px;
    border-top-left-radius: 3px; border-top-right-radius: 3px;
}
#chTabs QTabBar::tab:selected {
    background: #ffffff; color: #24292f; border-bottom: 2px solid #0969da;
}
#applyBtnA {
    color: #0969da; font-weight: bold;
}
#applyBtnA:hover {
    color: #0550ae;
}
#applyBtnB {
    color: #8250df; font-weight: bold;
}
#applyBtnB:hover {
    color: #6336b0;
}
#consoleOutput, #consoleInput {
    background-color: #ffffff; color: #24292f;
}
#exportLogDisplay {
    background-color: #ffffff; color: #656d76; font-size: 10px;
}

QLabel[statChannel="a"] {
    color: #0969da; font-size: 11px; font-weight: bold; font-family: monospace;
}
QLabel[statChannel="b"] {
    color: #8250df; font-size: 11px; font-weight: bold; font-family: monospace;
}

/* --- E3632A additions --- */
#outputBtnOff {
    font-size: 13px; font-weight: bold; color: #656d76;
}
#modeBadge, #liveMode {
    font-weight: bold;
}
#liveValV {
    color: #00884d;
}
#liveValI {
    color: #006b99;
}
#liveValP {
    color: #0969da;
}
#liveValE {
    color: #8250df;
}
#setpointLabel {
    color: #656d76; font-size: 11px;
}
#protBadge, #modeBadge {
    font-weight: bold;
}
#liveValR {
    color: #9a6700;
}
#setpointLabel {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 16px; font-weight: bold; color: #656d76;
}
